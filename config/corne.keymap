#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp TAB    &kp Q        &kp W         &kp E         &kp R          &kp T                 &kp Y          &kp U         &kp I         &kp O         &kp P          &kp BSPC
&kp FSLH   &kp A        &kp S         &kp D         &lt 4 F         &kp G                 &kp H          &kp J         &kp K         &kp L         &kp SEMI       &mt RGUI SQT
&kp LSHFT  &kp Z        &kp X         &kp C         &kp V          &kp B                 &kp N          &kp M         &kp COMMA     &kp DOT       &kp FSLH       &kp RSHFT
                                  &mt LCTRL ESC &lt 3 SPACE  &lt 2 TAB      &lt 1 RET      &kp BSPC       &kp LALT
            >;
        };

        layer_1 {
            bindings = <
&kp TAB    &kp N1       &kp N2        &kp N3        &kp N4         &kp N5                &kp N6         &kp N7        &kp N8        &kp N9        &kp N0         &kp BSPC
&bt BT_CLR &bt BT_SEL 0 &kp LS(LBKT)  &kp LS(LBKT)  &kp N9         &kp EQUAL             &kp N8         &kp N0        &kp LS(RBKT)  &kp LS(RBKT)  &kp BSLH       &trans
&kp LSHFT  &trans       &trans        &trans        &trans         &trans                &trans         &trans        &trans        &trans        &trans         &trans
                                  &kp LGUI     &trans        &kp MINUS    &kp RET       &trans         &kp RALT
            >;
        };

        layer_2 {
            bindings = <
&kp TAB    &kp N1       &kp C_VOL_DN  &kp C_MUTE    &kp C_VOL_UP   &kp N5                &kp N6         &kp N7        &kp UP        &kp N9        &kp N0         &kp BSPC
&kp LCTRL  &kp C_PREV   &kp C_PLAY    &kp C_PAUSE   &kp C_NEXT     &trans                &kp MINUS      &kp LEFT      &kp DOWN      &kp RIGHT     &kp BSLH       &kp GRAVE
&kp LSHFT  &trans       &trans        &trans        &trans         &trans                &kp MINUS      &kp EQUAL     &kp LS(LBKT)  &kp LS(RBKT)  &kp BSLH       &kp GRAVE
                                  &kp LGUI     &trans        &kp MINUS    &kp RET       &trans         &kp RALT
            >;
        };

        layer_3 {
            bindings = <
&trans     &trans       &trans        &trans        &kp F11        &kp F12               &kp KP_EQUAL   &kp KP_N7     &kp KP_N8     &kp KP_N9     &trans         &trans
&trans     &trans       &trans        &trans        &trans         &kp F8                &kp KP_N0      &kp KP_N4     &kp KP_N5     &kp KP_N6     &trans         &trans
&trans     &trans       &trans        &trans        &trans         &kp F2                &kp KP_MINUS   &kp KP_N1     &kp KP_N2     &kp KP_N3     &trans         &trans
                                  &trans       &trans        &trans       &trans        &trans         &trans
            >;
        };

        layer_4 {
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_CLR_ALL      &out OUT_USB   &out OUT_BLE  &out OUT_TOG  &caps_word     &studio_unlock &soft_off
&trans        &trans        &trans        &trans        &trans        &trans               &trans         &kp LC(SPACE) &trans        &trans         &trans         &trans
&trans        &trans        &trans        &trans        &trans        &trans               &trans         &trans        &trans        &trans         &trans         &trans
                                  &trans       &trans        &trans               &trans         &trans        &trans
            >;
        };
    };
};
